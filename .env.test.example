# Copia este archivo a .env.test y completa los valores (ese archivo esta ignorado por git).
#
# Usa EL MISMO proyecto de Supabase que produccion, pero en el schema "staging" en vez de
# "public", para no tener que crear ni pagar un segundo proyecto. Toma tu DATABASE_URL y
# DIRECT_URL reales (las que usas en produccion) y agregales "&schema=staging" al final
# (o "?schema=staging" si la URL no tiene parametros todavia).
#
# Ejemplo (NO son datos reales):
# DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true&schema=staging"
# DIRECT_URL="postgresql://usuario:password@host:5432/postgres?schema=staging"

DATABASE_URL=""
DIRECT_URL=""

# Secreto para firmar los links de PDF. Puede ser cualquier string en pruebas.
PDF_TOKEN_SECRET="dev-secret"

# Requeridos por NextAuth para firmar/cifrar la sesion.
# Genera uno propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# @sparticuz/chromium trae un binario para Linux/Vercel; en Windows local
# hay que apuntar a tu Chrome instalado para poder generar el PDF, ej:
# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
PUPPETEER_EXECUTABLE_PATH=""

# Usuario administrador que crea el seed (prisma:test:seed).
SEED_USER_EMAIL="admin@pandcasa.local"
SEED_USER_PASSWORD="Admin123!"
SEED_USER_NAME="Administrador de pruebas"

# Pon en 1 para que el seed tambien cree un cliente y una proforma de ejemplo
# (util para poder abrir /proformas/[id]/print-template y ver el PDF).
SEED_SAMPLE_DATA="1"
